{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vortex-bevy.local/contracts/vortex-unity-static-scene-v1.schema.json",
  "title": "Vortex Unity Static Scene Extraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "protocol_version",
    "editor_version",
    "urp_package_version",
    "scene",
    "unsupported_components"
  ],
  "properties": {
    "engine": { "const": "unity" },
    "protocol_version": { "const": "vortex.unity-static-scene/v1" },
    "editor_version": { "type": "string", "minLength": 1 },
    "urp_package_version": { "type": "string", "minLength": 1 },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_guid",
        "source_path",
        "object_id",
        "mesh",
        "material",
        "camera",
        "light"
      ],
      "properties": {
        "source_guid": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "source_path": { "type": "string", "pattern": "^Assets/[^\\\\]*$" },
        "object_id": { "type": "integer", "minimum": 0 },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positions", "normals", "uvs", "indices"],
          "properties": {
            "positions": { "$ref": "#/$defs/vector3_array" },
            "normals": { "$ref": "#/$defs/vector3_array" },
            "uvs": { "$ref": "#/$defs/vector2_array" },
            "indices": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shader", "base_color", "metallic", "smoothness", "base_color_texture"],
          "properties": {
            "shader": { "const": "Universal Render Pipeline/Lit" },
            "base_color": { "$ref": "#/$defs/color4" },
            "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
            "smoothness": { "type": "number", "minimum": 0, "maximum": 1 },
            "base_color_texture": { "type": "string", "pattern": "^textures/[a-z0-9._-]+\\.png$" }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "rotation", "scale", "vertical_fov_radians"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "rotation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "z", "w"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" },
                "w": { "type": "number" }
              }
            },
            "scale": { "$ref": "#/$defs/vector3" },
            "vertical_fov_radians": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 3.141592653589793 }
          }
        },
        "light": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "rotation", "scale", "kind", "intensity"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "rotation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "z", "w"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" },
                "w": { "type": "number" }
              }
            },
            "scale": { "$ref": "#/$defs/vector3" },
            "kind": { "enum": ["directional", "point"] },
            "intensity": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "unsupported_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "classification", "reason"],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "classification": { "const": "requires_adapter" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "vector2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "vector3_array": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/vector3" }
    },
    "vector2_array": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/vector2" }
    },
    "color4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "type": "number", "minimum": 0, "maximum": 1 },
        "g": { "type": "number", "minimum": 0, "maximum": 1 },
        "b": { "type": "number", "minimum": 0, "maximum": 1 },
        "a": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "transform_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation", "scale"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z", "w"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" },
            "w": { "type": "number" }
          }
        },
        "scale": { "$ref": "#/$defs/vector3" }
      }
    }
  }
}
